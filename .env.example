# Copy this file to .env and fill in the values.
# .env is gitignored and must never be committed.

# YouTube Data API v3 key: console.cloud.google.com -> enable "YouTube Data API v3"
# -> Credentials -> Create API key. Needed only for collection.
YOUTUBE_API_KEY=

# Anthropic API key for title suggestions in the app. Without it the app falls
# back to rule-based rewrites. (An `ant auth login` profile also works.)
ANTHROPIC_API_KEY=

# Only if Anthropic says the key is not scoped to a workspace:
ANTHROPIC_WORKSPACE_ID=

# Optional: which Claude model writes title suggestions.
# INSTINCT_CLAUDE_MODEL=claude-opus-5-5
